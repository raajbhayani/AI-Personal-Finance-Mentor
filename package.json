{
  "name": "ai-personal-finance-mentor",
  "version": "0.1.0",
  "private": true,
  "author": "Raj",
  "description": "AI-powered personal finance management application developed by Raj",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "NODE_ENV=production ANALYZE=false npm run build",
    "build:analyze": "ANALYZE=true npm run build",
    "build:staging": "NODE_ENV=production NEXT_PUBLIC_APP_ENV=staging npm run build",
    "start": "next start",
    "start:prod": "NODE_ENV=production npm run start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run type-check && npm run lint && npm run format:check",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:components": "jest --testPathPattern=components",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:ci": "jest --coverage --watchAll=false && playwright test",
    "coverage:open": "open coverage/lcov-report/index.html",
    "coverage:serve": "npx http-server coverage/lcov-report -p 8080 -o",
    "playwright:install": "playwright install",
    "playwright:install-deps": "playwright install-deps",
    "pretest:e2e": "npm run build",
    "deploy": "vercel --prod",
    "deploy:staging": "vercel",
    "deploy:preview": "vercel --no-wait",
    "predeploy": "npm run validate && npm run test:ci",
    "env:validate": "node scripts/validate-env.js",
    "env:setup": "node scripts/setup-env.js",
    "db:init": "node scripts/init-db.js",
    "db:setup": "node scripts/setup-database.js",
    "db:seed": "node scripts/seed-database.js",
    "seed": "npm run db:seed",
    "db:migrate": "node scripts/migrate.js",
    "db:reset": "node scripts/reset-db.js",
    "db:health": "curl -s http://localhost:3001/api/health | json_pp || echo 'Health check failed - is the server running?'",
    "performance:analyze": "node scripts/analyze-bundle.js",
    "performance:lighthouse": "node scripts/lighthouse.js",
    "security:audit": "npm audit && node scripts/security-check.js",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "clean:all": "npm run clean && rm -rf node_modules && npm install",
    "postinstall": "npm run playwright:install || true",
    "prepare": "husky install || true",
    "playwright:install": "playwright install --with-deps || echo 'Playwright install skipped'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "@apollo/client": "^3.11.4",
    "@apollo/server": "^4.10.4",
    "@graphql-tools/merge": "^9.1.1",
    "@hookform/resolvers": "^3.9.0",
    "apollo-server-micro": "^3.13.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "graphql": "^16.9.0",
    "graphql-tag": "^2.12.6",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.439.0",
    "mongoose": "^8.6.2",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-extended": "^6.0.0",
    "mongodb-memory-server": "^10.2.1",
    "msw": "^2.11.3",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.6.2"
  }
}
