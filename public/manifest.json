      "label": "Transaction tracking on mobile"
    },
    {
      "src": "/images/screenshots/analytics-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "platform": "wide",
      "label": "Financial analytics on desktop"
    }
  ],
