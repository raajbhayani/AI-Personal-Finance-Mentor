{
  "name": "AI Personal Finance Mentor",
  "short_name": "FinanceAI",
  "description": " personal finance management with budgeting tools, expense tracking, and financial insights",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#3B82F6",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "categories": ["finance", "productivity", "utilities"],
  "screenshots": [
    {
      "src": "/images/screenshots/dashboard-mobile.png",
